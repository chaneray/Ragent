# 数据库
MYSQL_ROOT_PASSWORD=ragent123
MYSQL_DATABASE=ragent
MYSQL_USER=ragent
MYSQL_PASSWORD=ragent123
DATABASE_URL=mysql+aiomysql://ragent:ragent123@localhost:3307/ragent

# Milvus
MILVUS_HOST=localhost
MILVUS_PORT=19530

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=localhost:9000

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT
SECRET_KEY=change-me-to-a-random-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# LLM 配置 (可选: dashscope / openai / deepseek)
LLM_PROVIDER=dashscope
LLM_MODEL=qwen-plus
OPENAI_API_KEY=sk-your-api-key
OPENAI_BASE_URL=
DEEPSEEK_API_KEY=sk-your-deepseek-key

# Embedding 配置（dashscope / openai / fake）
# dashscope 使用阿里云百炼平台 text-embedding-v4 (1024维)
EMBEDDING_PROVIDER=dashscope
EMBEDDING_MODEL=text-embedding-v4
